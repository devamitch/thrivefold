{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thrivefold.app/schemas/thrivefold-real-game-catalog-v3.schema.json",
  "title": "Thrivefold Real Game Content Catalog v3",
  "type": "object",
  "required": [
    "catalogMeta",
    "ethicalBoundaries",
    "experienceScopes",
    "profileContextSchema",
    "domains",
    "skillDefinitions",
    "difficultyDefinitions",
    "objectiveTypes",
    "ageEligibilityPolicies",
    "assessmentDefinitions",
    "assessmentQuestions",
    "derivedMeasurementDefinitions",
    "verificationPolicies",
    "pointEconomy",
    "skipAndReplacementRules",
    "dailyTaskRules",
    "specialQuestDefinitions",
    "chapterDefinitions",
    "levelStageDefinitions",
    "levelProgressionRules",
    "levelDefinitions",
    "coachingRules",
    "clientProjectionRules",
    "persistenceAndSyncRules",
    "releaseValidationRules",
    "guidanceReferences",
    "taskDefinitions",
    "privateRecordSchemas",
    "aiVerificationFramework",
    "poseLandmarkVerification",
    "sensitiveDataAndMediaPolicy",
    "taskPersonalizationRules",
    "toneProfiles",
    "intimacyAndRelationshipRules",
    "taskPresentationRules",
    "runtimeCapabilityRegistry",
    "specialQuestRewardRules",
    "verificationClassDefinitions",
    "newFeatureAcceptanceTests",
    "contextualScoringFramework",
    "contextualGraceAndEffortRules",
    "capstoneDefinitions",
    "domainScoreRubricDefinitions",
    "rewardPolicyDefinitions"
  ],
  "properties": {
    "catalogMeta": {
      "type": "object",
      "required": [
        "id",
        "version",
        "schemaVersion",
        "title",
        "taskCount",
        "specialQuestCount",
        "levelCount",
        "chapterCount",
        "capstoneCount",
        "domainScoreDimensionCount",
        "scorecardVersion"
      ]
    },
    "taskDefinitions": {
      "type": "array",
      "minItems": 100,
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "contentStatus",
          "title",
          "shortDescription",
          "purpose",
          "instructions",
          "category",
          "experienceScopes",
          "skillOutcomes",
          "difficulty",
          "estimatedDurationMinutes",
          "levelEligibility",
          "prerequisiteTaskIds",
          "objective",
          "verification",
          "points",
          "availability",
          "skipPolicyId",
          "substitutionTags",
          "completionPolicy",
          "offlinePolicy",
          "rewardPolicyId",
          "unlockIds",
          "accessibilityOptions",
          "safetyConstraints",
          "contentProvenance",
          "scoreDimensionIds",
          "scoringModelVersion",
          "contextualScoring",
          "chapterIds",
          "curriculumChapterIds",
          "domainScoring"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "shortDescription": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "instructions": {
            "type": "array",
            "minItems": 1
          },
          "experienceScopes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "levelEligibility": {
            "type": "object",
            "required": [
              "minimumLevel",
              "maximumLevel"
            ],
            "properties": {
              "minimumLevel": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "maximumLevel": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              }
            }
          },
          "objective": {
            "type": "object",
            "required": [
              "type"
            ]
          },
          "verification": {
            "type": "object",
            "required": [
              "policyId",
              "policyVersion",
              "verificationClass",
              "requiredEvidence",
              "failureReasons"
            ]
          },
          "points": {
            "type": "object",
            "required": [
              "taskPoints",
              "xp"
            ],
            "properties": {
              "taskPoints": {
                "type": "number",
                "minimum": 0
              },
              "xp": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "scoreDimensionIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "domainScoring": {
            "type": "object",
            "required": [
              "eligible",
              "rubricId",
              "dimensionIds",
              "modelVersion"
            ],
            "properties": {
              "eligible": {
                "type": "boolean"
              },
              "rubricId": {
                "type": "string"
              },
              "dimensionIds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "modelVersion": {
                "type": "string"
              }
            }
          }
        },
        "additionalProperties": true
      }
    },
    "levelDefinitions": {
      "type": "array",
      "minItems": 1000,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "level",
          "chapterId",
          "stageId",
          "title",
          "purpose",
          "primaryOutcome",
          "xpRequiredToAdvance",
          "minimumCumulativeXp",
          "advancementType",
          "recommendedTaskIds",
          "progressionRuleset",
          "scoreDimensionIds",
          "scoreRulesetVersion"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "chapterId": {
            "type": "string"
          },
          "stageId": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "recommendedTaskIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "scoreDimensionIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "scoreRulesetVersion": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "specialQuestDefinitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "id",
              "version",
              "title",
              "purpose",
              "description",
              "eligibleLevelRange",
              "eligibleExperienceScopes",
              "replacesCategories",
              "taskIds",
              "completionRule",
              "verificationPolicyId",
              "points",
              "repeatPolicy",
              "offlinePolicy",
              "safety",
              "rewardPolicyId"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "integer",
                "minimum": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "eligibleLevelRange": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                }
              },
              "taskIds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "verificationPolicyId": {
                "type": "string"
              },
              "rewardPolicyId": {
                "type": "string"
              }
            },
            "additionalProperties": true
          },
          {
            "type": "object",
            "required": [
              "id",
              "version",
              "title",
              "description",
              "chapterId",
              "eligibleLevelRange",
              "taskIds",
              "completionRule",
              "verificationPolicyId",
              "points",
              "replayPolicy",
              "rewardPolicyId",
              "safety"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "integer",
                "minimum": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "chapterId": {
                "type": "string"
              },
              "eligibleLevelRange": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                }
              },
              "taskIds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "verificationPolicyId": {
                "type": "string"
              },
              "rewardPolicyId": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "chapterDefinitions": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "required": [
          "id",
          "order",
          "title",
          "levels",
          "recommendedTaskIds",
          "capstoneId",
          "scoreDimensionIds",
          "scoreRulesetVersion"
        ],
        "additionalProperties": true
      }
    },
    "capstoneDefinitions": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "title",
          "purpose",
          "chapterId",
          "requiredAtLevel",
          "eligibleLevelRange",
          "skillFocus",
          "requiredTaskIds",
          "completionRule",
          "verificationPolicyId",
          "reward",
          "offlinePolicy",
          "safetyAndEligibility",
          "contentStatus"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "requiredAtLevel": {
            "type": "integer",
            "minimum": 50,
            "maximum": 1000
          },
          "requiredTaskIds": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "verificationPolicyId": {
            "type": "string"
          },
          "reward": {
            "type": "object",
            "required": [
              "taskPoints",
              "xp",
              "awardOnce",
              "rewardPolicyId"
            ],
            "properties": {
              "taskPoints": {
                "type": "number",
                "minimum": 0
              },
              "xp": {
                "type": "number",
                "minimum": 0
              },
              "rewardPolicyId": {
                "type": "string"
              }
            }
          }
        },
        "additionalProperties": true
      }
    },
    "verificationPolicies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": true
      }
    },
    "objectiveTypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": true
      }
    },
    "skillDefinitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": true
      }
    },
    "profileContextSchema": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "dataType",
          "required",
          "sensitivity",
          "collection",
          "purpose",
          "permittedUses",
          "prohibitedUses"
        ],
        "additionalProperties": true
      }
    },
    "contextualScoringFramework": {
      "type": "object",
      "required": [
        "version",
        "scoreDimensions",
        "domainScoringAlgorithm",
        "userConfigurableCompositeScore",
        "explicitContextScoreBindings"
      ],
      "properties": {
        "scoreDimensions": {
          "type": "array",
          "minItems": 40,
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "method"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "type": "string",
                "minLength": 1
              },
              "inputs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "domainScoreRubricDefinitions": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "appliesTo",
          "inputRequirements",
          "formula",
          "missingInputHandling",
          "output"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "appliesTo": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "rewardPolicyDefinitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "purpose"
        ],
        "additionalProperties": true
      }
    },
    "newFeatureAcceptanceTests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "assertion"
        ],
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
