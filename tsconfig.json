{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*", "./src/*"],
      "@assets/*": ["assets/*", "./assets/*"],
      "setu-squircle": ["modules/setu-squircle"],
      "setu-squircle/*": ["modules/setu-squircle/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
