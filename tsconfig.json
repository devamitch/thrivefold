{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["node", "jest"],
    "paths": {
      "@/*": ["./src/*"],
      "@assets/*": ["./assets/*"],
      "setu-squircle": ["./modules/setu-squircle"],
      "setu-squircle/*": ["./modules/setu-squircle/*"],
      "pose-landmarker": ["./modules/pose-landmarker"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", "supabase/functions", "**/* copy.ts", "**/* copy.tsx"]
}
