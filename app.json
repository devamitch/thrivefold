{
  "expo": {
    "name": "Thrivefold",
    "slug": "thrivefold",
    "scheme": "thrivefold",
    "version": "1.0.4",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/app-icon-all.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.amit.thrivefold",
      "versionCode": 5,
      "allowBackup": false,
      "icon": "./assets/images/app-icon-android-legacy.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon-android-adaptive-foreground.png",
        "backgroundColor": "#FAF7F2"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.WRITE_EXERCISE",
        "android.permission.health.READ_OXYGEN_SATURATION",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_HEART_RATE_VARIABILITY",
        "android.permission.health.READ_RESPIRATORY_RATE",
        "android.permission.health.READ_BLOOD_PRESSURE",
        "android.permission.health.READ_BLOOD_GLUCOSE",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT"
      ],
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.ACCESS_ADSERVICES_AD_ID",
        "android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "ios": {
      "bundleIdentifier": "com.amit.thrivefold",
      "buildNumber": "3",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Thrivefold uses your camera for private, on-device pose estimation, exercise tracking, and nutrition meal photos.",
        "NSPhotoLibraryUsageDescription": "Thrivefold accesses your library to select nutrition meal photos and attach letter stamps.",
        "NSPhotoLibraryAddUsageDescription": "Thrivefold saves your exported wellness data spreadsheets, summaries, and receipts to your device.",
        "NSHealthShareUsageDescription": "Thrivefold reads your steps, heart rate, and sleep to provide mindful daily guidance.",
        "NSHealthUpdateUsageDescription": "Thrivefold syncs completed mindful workouts and training sessions to your health records."
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "web": {
      "favicon": "./assets/images/app-icon-web-favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "./plugins/withLocalReleaseSigning.js",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Thrivefold uses your location only when you tap Share my location during a trip check-in, to put a map link in the message you send.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Thrivefold uses the microphone only while you talk to the coach or do voice practice. Audio is processed on this phone and never saved.",
          "speechRecognitionPermission": "Thrivefold turns your speech into text for voice commands and voice practice.",
          "androidSpeechServicePackages": [
            "com.google.android.as",
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Geist-Regular.ttf",
            "./assets/fonts/Geist-Medium.ttf",
            "./assets/fonts/Geist-SemiBold.ttf",
            "./assets/fonts/Geist-Bold.ttf",
            "./assets/fonts/Fraunces-Medium.ttf",
            "./assets/fonts/Fraunces-SemiBold.ttf",
            "./assets/fonts/Fraunces-Variable.ttf",
            "./assets/fonts/SpaceGrotesk-Regular.ttf",
            "./assets/fonts/SpaceGrotesk-Medium.ttf",
            "./assets/fonts/SpaceGrotesk-SemiBold.ttf",
            "./assets/fonts/SpaceGrotesk-Bold.ttf",
            "./assets/fonts/SpaceMono-Regular.ttf",
            "./assets/fonts/SpaceMono-Bold.ttf"
          ]
        }
      ],
      "expo-localization",
      "expo-sqlite",
      "expo-image",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "extraProguardRules": "# Custom Expo modules (created by name; props bound by reflection).\n-keep class expo.modules.setusquircle.** { *; }\n-keep class expo.modules.localai.** { *; }\n-keep class expo.modules.poselandmarker.** { *; }\n-keep class expo.modules.stepcounter.** { *; }\n# Llamatik (llama.cpp): native code calls back into Kotlin and is found with Class.forName.\n-keep class com.llamatik.** { *; }\n-keep interface com.llamatik.** { *; }\n-dontwarn com.llamatik.**\n# MediaPipe tasks: JNI callbacks and protobuf read by reflection.\n-keep class com.google.mediapipe.** { *; }\n-keep class com.google.protobuf.** { *; }\n-dontwarn com.google.mediapipe.**\n-dontwarn com.google.protobuf.**"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-screen.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#FAF7F2"
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-secure-store",
      "react-native-health-connect",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [],
          "bluetoothAlwaysPermission": "Thrivefold connects to a heart-rate monitor you choose, only while you are using it.",
          "neverForLocation": true
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      [
        "@react-native-firebase/analytics",
        {
          "ios": {
            "withoutAdIdSupport": true,
            "googleAppMeasurementOnDeviceConversion": true
          }
        }
      ]
    ],
    "experiments": {
      "tsconfigPaths": true,
      "typedRoutes": true
    },
    "extra": {
      "googleWebClientId": "976390431722-9msfcuu1q0p2co1p40c3i4dnd6tuk8di.apps.googleusercontent.com",
      "router": {},
      "eas": {
        "projectId": "c8672e6c-cf56-450a-a097-eed822317968"
      }
    },
    "owner": "amit98ch"
  }
}
