# ── Supabase ──
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-anon-key
EXPO_PUBLIC_SUPABASE_CALLBACK_URL=https://your-project-ref.supabase.co/auth/v1/callback

# ── Firebase ──
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ── AI Providers ──
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_GEMINI_API_KEY_2=
EXPO_PUBLIC_GROQ_API_KEY=
EXPO_PUBLIC_GROQ_API_KEY_2=
EXPO_PUBLIC_OPENROUTER_API_KEY=

# ── Voice & Speech ──
EXPO_PUBLIC_SARVAM_API_KEY=
EXPO_PUBLIC_SARVAM_API_KEY_2=
EXPO_PUBLIC_ELEVENLABS_API_KEY=
EXPO_PUBLIC_DEEPGRAM_API_KEY=

# ── AI Search & Embeddings ──
EXPO_PUBLIC_COHERE_API_KEY=
EXPO_PUBLIC_VOYAGE_API_KEY=
EXPO_PUBLIC_EXA_API_KEY=

# ── Memory / RAG ──
EXPO_PUBLIC_MEM0_API_KEY=

# ── Device Test Exception (Set to true to bypass gates on personal device) ──
EXPO_PUBLIC_ENABLE_ALL_FEATURES=false

# ── Observability (server-side only) ──
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://hipaa.cloud.langfuse.com

# ── Server-only (Supabase edge functions, NOT client) ──
SUPABASE_SERVICE_ROLE_KEY=
